# ============================================================
# TERMINAL ELITE HORIZON — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs
# ============================================================

# ── Serveur ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Clé secrète JWT (générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=remplacez-par-une-cle-secrete-longue-et-aleatoire

# ── Adaptateur de base de données ────────────────────────────
# Valeurs possibles : airtable | supabase | sqlite | postgres (voir server/db/index.js)
DB_ADAPTER=airtable

# ── Airtable (requis si DB_ADAPTER=airtable) ─────────────────
# Créer un compte sur https://airtable.com, puis :
#   1. Créer une base avec 2 tables (voir server/db/airtable.js pour le schéma)
#   2. Générer un Personal Access Token sur https://airtable.com/create/tokens
#      (scopes requis : data.records:read, data.records:write, schema.bases:read)
#   3. Récupérer l'ID de la base dans l'URL : https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_USERS_TABLE=Users
AIRTABLE_PORTFOLIOS_TABLE=Portfolios

# ── Supabase (requis si DB_ADAPTER=supabase) ─────────────────
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=eyJhbGci...

# ── SQLite (requis si DB_ADAPTER=sqlite) ─────────────────────
# SQLITE_PATH=./data/elite_horizon.db

# ── PostgreSQL (requis si DB_ADAPTER=postgres) ───────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/elite_horizon
